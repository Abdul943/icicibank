liveness probe for exec,
livenessProbe:
  exec:
    command:
      - cat
      - /tmp/healthy
  initialDelaySeconds: 5

liveness probe for tcpSocket,
livenessProbe:
  tcpSocket:
     port: 8080
  initialDelaySeconds: 15

livenessProbe for httpGet
livenessProbe:
  httpGet:
    path: /healthz
    port: 8080

===

readinessProbe:
  exec:
