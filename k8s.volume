apiVersion: v1
kind: Pod
metadata:
  name: test-vol
spec:
  containers:
  - name: test-container
    image: coolgourav147/nginx-custom
    volumeMounts:
      - mountPath: /data
        name: first-volume
  volumes:
  - name: first-volume
    awsElasticBlockStore:
      volumeID: "vol-0826024a53e806464"            #insert EBS volume ID here 
      fsType: ext4

kubectl apply -f ebsvolume.yml
kubectl describe pod test-vol

